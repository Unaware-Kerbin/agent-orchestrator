{
  "name": "agent-orchestrator",
  "version": "0.1.7",
  "description": "MCP orchestrator that routes work to Cursor agents and external LLM agents",
  "type": "module",
  "bin": {
    "agent-orchestrator": "./dist/index.js",
    "agent-orchestrator-gui": "./dist/gui.js",
    "agent-orchestrator-mcp": "./dist/mcp-http.js"
  },
  "scripts": {
    "start": "tsx src/index.ts",
    "mcp:http": "tsx src/mcp-http.ts",
    "dev": "tsx watch src/index.ts",
    "gui": "node scripts/ensure-late-infer.js && tsx src/gui.ts",
    "gui:open": "tsx src/gui.ts --open",
    "gui:stop": "tsx src/gui.ts --stop",
    "gui:restart": "tsx src/gui.ts --restart",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test test/*.test.ts",
    "infer:build": "bash scripts/build-late-infer.sh",
    "pack": "bash scripts/pack.sh"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "license": "MIT",
  "dependencies": {
    "@cursor/sdk": "^1.0.31",
    "@modelcontextprotocol/server": "^2.0.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.1",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2"
  },
  "overrides": {
    "undici": "6.28.0"
  }
}
