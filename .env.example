# Copy to .env and fill in. Never commit .env.

# Cursor SDK (local + cloud specialists that can edit the workspace)
CURSOR_API_KEY=

# Optional default workspace for local Cursor agents
# WORKSPACE_CWD=/absolute/path/to/repo

# Optional path to agents.config.yaml (defaults to this project's file)
# AGENT_ORCHESTRATOR_CONFIG=/absolute/path/to/agents.config.yaml

# Local GUI (npm run gui) — loopback only. Token is stored in .orchestrator/gui.secret
# AGENT_ORCHESTRATOR_GUI_PORT=8787
# AGENT_ORCHESTRATOR_STATE_DIR=/absolute/path/to/.orchestrator
# AGENT_ORCHESTRATOR_ALLOWLIST=/absolute/path/to/write-allowlist.json

# External backends — set only the ones you use
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=

# Google AI Studio (any of these names work; config default is GEMINI_API_KEY)
GEMINI_API_KEY=
# GOOGLE_API_KEY=
# GOOGLE_GENERATIVE_AI_API_KEY=

# Optional bearer for a local OpenAI-compatible server (usually unused)
# VLLM_API_KEY=

# Hugging Face (gated models). Also accepted: HUGGING_FACE_HUB_TOKEN
# HF_TOKEN=

# Local model snapshots (must stay inside the write allowlist)
# AGENT_ORCHESTRATOR_MODELS_DIR=/absolute/path/to/.orchestrator/models

# Generic HTTP agent
# CUSTOM_AGENT_TOKEN=
# CUSTOM_AGENT_URL=https://example.com/agent
