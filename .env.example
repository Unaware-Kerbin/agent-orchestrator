# Copy to .env and fill in. Never commit .env.

# Cursor SDK (local + cloud specialists that can edit the workspace)
CURSOR_API_KEY=

# Optional default workspace for local Cursor agents
# WORKSPACE_CWD=/absolute/path/to/repo

# Optional path to agents.config.yaml (defaults to this project's file)
# AGENT_ORCHESTRATOR_CONFIG=/absolute/path/to/agents.config.yaml

# Local GUI (npm run gui) — loopback only. Token is stored in .orchestrator/gui.secret
# AGENT_ORCHESTRATOR_GUI_PORT=8787
# AGENT_ORCHESTRATOR_STATE_DIR=/absolute/path/to/.orchestrator
# AGENT_ORCHESTRATOR_ALLOWLIST=/absolute/path/to/write-allowlist.json

# HTTP MCP (any client): http://127.0.0.1:8790/mcp after npm run mcp:http
# GUI is :8787 (not MCP). Temp pcap analyze webhook (Bearer = .orchestrator/gui.secret):
#   POST http://127.0.0.1:8787/api/temp-analyze  or  http://127.0.0.1:8790/api/temp-analyze
#   { "path": "/absolute/file.pcap" }  then DELETE the same path when analysis is done.
# Default auth is the GUI token. Optional LDAP/RADIUS are off until you set MCP_AUTH.
# AGENT_ORCHESTRATOR_MCP_AUTH=local-token
# Dedicated MCP port (same auth, still 127.0.0.1 only): npm run mcp:http
# AGENT_ORCHESTRATOR_MCP_PORT=8790
# AGENT_ORCHESTRATOR_MCP_HOST=127.0.0.1

# Optional Active Directory (LDAPS). Never put the bind password in YAML.
# AGENT_ORCHESTRATOR_MCP_AUTH=local-token,ldap
# AGENT_ORCHESTRATOR_LDAP_URL=ldaps://dc.example.com:636
# AGENT_ORCHESTRATOR_LDAP_BIND_DN=CN={username},CN=Users,DC=example,DC=com
# AGENT_ORCHESTRATOR_LDAP_BASE_DN=DC=example,DC=com
# AGENT_ORCHESTRATOR_LDAP_FILTER=(sAMAccountName={username})
# AGENT_ORCHESTRATOR_LDAP_ALLOWED_GROUPS=CN=MCP Users,OU=Groups,DC=example,DC=com
# LDAP_BIND_PASSWORD=   # store via GUI secrets or here; gitignored .env only

# Optional RADIUS (ClearPass / Cisco ISE). Shared secret via GUI secrets, not YAML.
# AGENT_ORCHESTRATOR_MCP_AUTH=local-token,radius
# AGENT_ORCHESTRATOR_RADIUS_HOST=clearpass.example.com
# AGENT_ORCHESTRATOR_RADIUS_PORT=1812
# AGENT_ORCHESTRATOR_RADIUS_ALLOWED_FILTER_IDS=mcp-users
# RADIUS_SECRET=

# External backends — set only the ones you use
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=

# Google AI Studio (any of these names work; config default is GEMINI_API_KEY)
GEMINI_API_KEY=
# GOOGLE_API_KEY=
# GOOGLE_GENERATIVE_AI_API_KEY=

# Optional bearer for a local OpenAI-compatible server (usually unused)
# VLLM_API_KEY=

# Hugging Face (gated models). Also accepted: HUGGING_FACE_HUB_TOKEN
# HF_TOKEN=

# Local model snapshots (must stay inside the write allowlist)
# AGENT_ORCHESTRATOR_MODELS_DIR=/absolute/path/to/.orchestrator/models

# Generic HTTP agent
# CUSTOM_AGENT_TOKEN=
# CUSTOM_AGENT_URL=https://example.com/agent
